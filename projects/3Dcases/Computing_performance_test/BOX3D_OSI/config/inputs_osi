stop_time = 32.0

geometry.is_periodic = 1 1 1

amr.max_level = 0
amr.regrid_int = 1000000
amr.grid_eff = 1.0
amr.n_error_buf = 0
amr.max_grid_size = 16
amr.blocking_factor = 16
amr.plot_int = -1

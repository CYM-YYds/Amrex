# =============================================================================
# 1. 运行终止条件
# 达到 max_step 或 stop_time 中任一条件时结束计算。
# =============================================================================
max_step  = 96000
stop_time = 2500000.0

# =============================================================================
# 2. 物理参数与 LBM 数值模式
# =============================================================================

# 雷诺数；当前运动黏度按 nu = U0 * Lx / Re 计算，其中 U0 仍由源码定义。
lbm.reynolds_number = 3200.0

# BGK 碰撞内核：
# 0 = 原始通用路径，作为数值与性能基准
# 1 = 无外力、无 SGS 的 D3Q27 专用优化路径
lbm.collide_mode = 1

# DDF 推进与存储模式：
# 0 = canonical A-B 数值基准模式
# 1 = grown-Fab OSI 模式；要求 collide_mode=1
# OSI checkpoint 以 canonical DDF 写出，restart 后统一重置为 phase=0。
lbm.stream_mode = 1

# 粗到细 DDF 插值模式：
# 0 = ratio-2 三线性插值
# 1 = GPU 守恒线性插值
# 2 = GPU 单元二次插值
lbm.interp_mode = 0

# 粗细网格覆盖掩码：
# 0 = 粗层所有 cell 都参与 Collide/Stream
# 1 = 跳过被细层覆盖的粗层内部 cell
lbm.cf_mask_mode = 1

# =============================================================================
# 3. 计算域与基础网格
# 当前 LBM 内核要求三个方向的 coarse cell spacing 相同。
# =============================================================================
geometry.prob_lo     =  0.0   0.0   0.0
geometry.prob_hi     =  1.0   1.0   1.0
geometry.is_periodic =  0     0     0
amr.n_cell           =  128   128   128

# =============================================================================
# 4. AMR 层级、网格划分与加密判据
# max_level 是最高层编号；2 表示启用 level 0、1、2。
# 数组按 AMR 层级依次给值，多余值不会用于当前 max_level。
# =============================================================================
amr.max_level  = 2
amr.regrid_int = 32
amr.grid_eff   = 0.7

amr.n_error_buf       = 1   1   1   1
amr.max_grid_size     = 128 128 128 128
amr.blocking_factor_x = 32  32  32  32
amr.blocking_factor_y = 32  32  32  32
amr.blocking_factor_z = 32  32  32  32

# 各层基于涡量的加密阈值；第 lev 项由 ErrorEst() 在该层使用。
lbm.err = 0.64   1.28  2.56  5.12

# OSI 在多层 AMR、多 Fab/MPI、全周期和六面非周期边界下均有实现。
# max_level > 1 时程序仍会给出验证警告：四层 OSI/A-B 逐单元等价尚未达到
# 1e-12，且历史动态 regrid 冒烟测试曾在第 128 步捕获 NaN。

# =============================================================================
# 5. OSI 通信策略
# 这些开关只影响 stream_mode=1；默认配置保留 host-staging 回退。
# =============================================================================

# 同一 MPI rank 内直接复制 grown-Fab 重叠区。
lbm.osi_local_direct = 1

# 跨 MPI rank 使用 OSI-aware pack/unpack；0 使用原有通信回退路径。
lbm.osi_mpi_direct = 0

# 使用 device buffer 直接进行 MPI 通信。必须同时满足：
# osi_mpi_direct=1，且 MPI 实现支持 GPU-aware MPI。
lbm.osi_mpi_device_direct = 0

# Host-staging 分块流水的每块字节数；0 表示整块同步路径。
# 仅适用于 osi_mpi_direct=1、device_direct=0、async_staging=0；
# 当前单 peer 性能测试的历史较优值为 2097152。
lbm.osi_mpi_pipeline_chunk_bytes = 0

# canonical 通信缓冲每批处理的 DDF 分量数，允许范围 1..27。
# 1 最省临时内存；3 或 9 可将每步 FillBoundary 次数降为 9 或 3。
lbm.osi_sync_batch_components = 3

# =============================================================================
# 6. 性能统计
# 每 report_int 个绝对 step 输出本统计窗口的耗时、计数和 MLUPS，随后清零。
# 短测可通过 AMREX_RUN_ARGS 覆盖为 10 或 100。
# =============================================================================
performance.report_int = 1000

# =============================================================================
# 7. PlotFile 输出
# 每 amr.plot_int 个 coarse step 输出速度、密度、Q 和 Vorticity；
# step 小于 amr.begin_plot 时不输出。
# =============================================================================
amr.plot_file  = data32to128_validation/case_Re3200_
amr.plot_int   = 3200
amr.begin_plot = 0

# =============================================================================
# 8. Checkpoint 与重启
# begin_step=0 表示新算例；大于 0 时从 chk_prefix 对应 checkpoint 重启。
# keep_latest_only=true 时只保留最新 checkpoint。
# =============================================================================
checkpoint.begin_step = 0
checkpoint.chk_int = 32000
checkpoint.chk_prefix = chk_osi_validation
checkpoint.keep_latest_only = true
checkpoint.write_particles = false

# =============================================================================
# 9. Level 0 速度场收敛监测
# trend_int：只输出速度变化趋势，不参与停止判定。
# check_int：执行正式判定；相对 L2 变化连续 required 次低于 tolerance 后停止。
# 两个间隔都以本次启动后的步数 step - begin_step 计算。
# =============================================================================
verification.convergence_enabled = true
verification.convergence_trend_int = 1000
verification.convergence_check_int = 3200
verification.convergence_tolerance = 1.0e-4
verification.convergence_required = 3

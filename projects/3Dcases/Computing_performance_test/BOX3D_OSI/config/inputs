# *****************************************************************
# Run until nsteps == max_step or time == stop_time,
#     whichever comes first
# *****************************************************************
max_step  = 224000
stop_time = 2500000.0

amr.regrid_int  = 32
amr.max_level   = 3

amr.grid_eff          = 0.7
amr.n_error_buf       = 1 1 1 1
amr.max_grid_size     = 64 64 64 64
amr.blocking_factor_x = 32 32 32 32
amr.blocking_factor_y = 32 32 32 32
amr.blocking_factor_z = 32 32 32 32

amr.plot_file  = data32to64_validation/case_Re1000_
amr.plot_int   = 32000
amr.begin_plot = 0
# 每 8000 个 coarse 步分别输出：速度 ux/uy/uz、密度 rho、Q/Vorticity。
# 可用于中心线速度、质量守恒和涡结构随时间的正确性/收敛验证。

checkpoint.begin_step = 192000
checkpoint.chk_int = 32000
checkpoint.chk_prefix = chk_osi_validation
checkpoint.keep_latest_only = true
checkpoint.write_particles = false

lbm.err = 0.004 0.008 0.016 0.032

# 粗细网格覆盖掩码模式：
# 0 = 不使用 mask，粗层所有 cell 都参与 Collide/Stream
# 1 = 使用逐 cell mask，跳过被细层覆盖的粗层内部 cell（当前实测默认）
lbm.cf_mask_mode = 1

# BGK 碰撞内核：
# 0 = 原始通用路径（保留作为数值/性能基线）
# 1 = 无外力/无 SGS 的 D3Q27 专用路径，寄存器复用 DDF 并合并 feq 公共项
lbm.collide_mode = 1

# DDF 碰撞分布函数的流动/存储模式：
# 0 = 保留的 A-B 数值基准模式
# 1 = grown-Fab OSI 模式；支持编译配置内的多层 AMR、多 Fab/MPI，以及全周期或六面
#     非周期边界，要求 collide_mode=1；checkpoint 以 canonical DDF 写出，restart
#     统一重置为 phase=0。ParticleContainer 的 AoS/SoA 可随 checkpoint 重启；
#     运动刚体的 host 侧质心、速度、角速度和力/力矩尚未持久化
# 默认保持在已经通过逐单元 A/B 的两层范围。三层以上已解除编译硬限制，但当前
# 四层 OSI/A-B 逐单元误差仍约 1e-4，且动态 regrid 冒烟在第 128 步捕获 NaN；
# 仅通过诊断脚本显式覆盖 amr.max_level=3，不作为已确认的生产数值结果。
lbm.stream_mode = 0

# OSI canonical 通信缓冲一次处理的 DDF 分量数，范围 1..27。
# 1 最省临时内存；3/9 可分别把每步 FillBoundary 次数降为 9/3。
lbm.osi_sync_batch_components = 3

# 粗到细 DDF 插值：
# 0 = ratio-2 三线性（现有快速基线）
# 1 = GPU 守恒线性（CellConservativeLinear 风格的受限斜率）
# 2 = GPU 单元二次插值（CellQuadratic 的笛卡尔 ratio-2 路径）
lbm.interp_mode = 0

# 启动时总会检查一次全部 active level；正确性运行还在每次动态 regrid 后检查，
# 以便新建/重构 fine level 出现 NaN、Inf 或非正密度时立即停止。
verification.check_state_after_regrid = false
verification.check_state_each_substep = false
verification.convergence_enabled = true
verification.convergence_check_int = 3200
verification.convergence_trend_int = 1000
verification.convergence_tolerance = 1.0e-12
verification.convergence_required = 3


+// 逐行提取 active 区间，并沿 y/z 合并；只在布局/掩码失效后构建。
+void AmrCoreLBM::BuildCollisionWork(int lev, int n) {
+    auto& state = osi_state.at(lev);
+    auto& cache = collision_work.at(lev);
+    iMultiFab same(state.boxArray(), state.DistributionMap(),1,state.nGrowVect());
+    same.setVal(1); same.setVal(0,0,1,0);
+    same.FillBoundary(Geom(lev).periodicity());
+    std::array<Vector<BoundaryWorkTag>,3> full, trimmed;
+    const bool has_fine = lev < finest_level;
+    for (MFIter mfi(state,false); mfi.isValid(); ++mfi) {
+        const Box valid = mfi.validbox();
+        const Box ring = amrex::grow(valid,state.nGrowVect());
+        const Box bx = amrex::grow(valid,n) & Geom(lev).growPeriodicDomain(n);
+        const auto fab = OSI::MakeOsiFabContext(ring,0).fab;
+        const int li=mfi.LocalIndex(), pi=osi_fab_phase_cache.at(lev).slot(mfi.index());
+        const int subset=osi_fillboundary_cache.at(lev).send_fabs.at(mfi.index())+1;
+        auto add = [&](const Box& region, bool trim) {
+            auto& tags = trim ? trimmed : full;
+            auto& counts = trim ? cache.trimmed_cells : cache.full_cells;
+            for (int target : {0,subset}) {
+                tags[target].push_back({region,fab,li,pi});
+                counts[target] += region.numPts();
+            }
+        };
+        add(bx,false);
+        BaseFab<int> hs(ring,1,The_Pinned_Arena());
+        Gpu::dtoh_memcpy(hs.dataPtr(),same[mfi].dataPtr(),hs.nBytes());
+        BaseFab<int> hc(ring,1,The_Pinned_Arena()), hi(ring,1,The_Pinned_Arena());
+        if (has_fine) {
+            Gpu::dtoh_memcpy(hc.dataPtr(),covered_mask[lev][mfi].dataPtr(),hc.nBytes());
+            Gpu::dtoh_memcpy(hi.dataPtr(),interface_mask[lev][mfi].dataPtr(),hi.nBytes());
+        }
+        auto sm=hs.const_array(), cm=hc.const_array(), im=hi.const_array();
+        auto active=[&](int i,int j,int k) {
+            return (valid.contains(IntVect(AMREX_D_DECL(i,j,k))) || sm(i,j,k)!=0) &&
+                   (!has_fine || cm(i,j,k)==0 || im(i,j,k)!=0);
+        };
+        Vector<Box> regions;
+        std::map<std::tuple<int,int,int,int>,int> previous_z;
+        for(int k=bx.smallEnd(2);k<=bx.bigEnd(2);++k) {
+            Vector<Box> plane;
+            std::map<std::pair<int,int>,int> previous_y;
+            for(int j=bx.smallEnd(1);j<=bx.bigEnd(1);++j) {
+                std::map<std::pair<int,int>,int> current_y;
+                int i=bx.smallEnd(0);
+                while(i<=bx.bigEnd(0)) {
+                    if(!active(i,j,k)) { ++i; continue; }
+                    int lo=i++; while(i<=bx.bigEnd(0) && active(i,j,k)) { ++i; }
+                    const auto key=std::make_pair(lo,i-1);
+                    auto it=previous_y.find(key);
+                    if(it!=previous_y.end()) {
+                        plane[it->second].setBig(1,j); current_y[key]=it->second;
+                    } else {
+                        current_y[key]=plane.size();
+                        plane.emplace_back(IntVect(lo,j,k),IntVect(i-1,j,k));
+                    }
+                }
+                previous_y=std::move(current_y);
+            }
+            std::map<std::tuple<int,int,int,int>,int> current_z;
+            for(const auto& box:plane) {
+                auto key=std::make_tuple(box.smallEnd(0),box.bigEnd(0),box.smallEnd(1),box.bigEnd(1));
+                auto it=previous_z.find(key);
+                if(it!=previous_z.end()) {
+                    regions[it->second].setBig(2,k); current_z[key]=it->second;
+                } else { current_z[key]=regions.size(); regions.push_back(box); }
+            }
+            previous_z=std::move(current_z);
+        }
+        for(const auto& region:regions) { add(region,true); }
+    }
+    for(int subset=0;subset<3;++subset) {
+        cache.full[subset].define(full[subset]); cache.trimmed[subset].define(trimmed[subset]);
+    }
+    amrex::Print() << "COLLISION_WORK lev=" << lev << " full_tags=" << full[0].size()
+                   << " trimmed_tags=" << trimmed[0].size() << " full_cells=" << cache.full_cells[0]
+                   << " trimmed_cells=" << cache.trimmed_cells[0] << "\n";
+    cache.ready=true;
+}

If:
  PathMatch: .*

CompileFlags:
  CompilationDatabase: config
  Remove:
    - -std=*
    - --std=*
    - -D__CUDA_ARCH__=*
    - -D__CUDA_ARCH_LIST__=*
  Add:
    - -std=c++20
    - -D__host__=
    - -D__device__=
    - -D__global__=
    - -D__constant__=
    - -D__shared__=
    - -D__launch_bounds__(...)=
    # cuda_runtime.h omits blockIdx in host-only parsing; threadIdx has the same dim3 shape.
    - -DblockIdx=threadIdx
    - -isystem
    - /home/HPCBase/compilers/cuda/12.8.0/targets/sbsa-linux/include
    - -include
    - cuda_runtime.h

Index:
  Background: Build
  StandardLibrary: Yes

Diagnostics:
  ClangTidy:
    Add: []
    Remove: ['*']

Completion:
  AllScopes: true

---
If:
  PathMatch: .*D3Q19\.H

CompileFlags:
  Add:
    - -include
    - /home/huazkjdxmrsgjzdsyshi/whcs-share18/caiyimin/learnamerx/Amrex/amrex-26.06/Src/Base/AMReX_REAL.H
    - -include
    - /home/huazkjdxmrsgjzdsyshi/whcs-share18/caiyimin/learnamerx/Amrex/amrex-26.06/Src/Base/AMReX_RealVect.H

---
If:
  # Index only this case root using absolute path.
  PathMatch: ^/home/huazkjdxmrsgjzdsyshi/whcs-share18/caiyimin/learnamerx/Amrex/projects/3Dcases/Computing_performance_test/BOX3D/.*

Index:
  Background: Build

---
If:
  # Re-enable AMReX source tree indexing using absolute path.
  PathMatch: ^/home/huazkjdxmrsgjzdsyshi/whcs-share18/caiyimin/learnamerx/Amrex/amrex-26\.06/.*

Index:
  Background: Build

---
If:
  # Skip other repository paths to reduce cross-case symbol pollution.
  PathMatch: ^/home/huazkjdxmrsgjzdsyshi/whcs-share18/caiyimin/learnamerx/Amrex/.*

Index:
  Background: Skip
